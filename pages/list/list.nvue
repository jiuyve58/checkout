<template>
	<view class="page-container">
		<view class="content-wrapper">
			<view class="header">
				<view class="header-left">
					<view class="header-info">
						<text class="header-date">{{ currentDate }}</text>
						<text class="header-greeting">好书相伴，静好岁月。</text>
					</view>
				</view>
				<view class="header-avatar">
					<image class="avatar-img" src="/static/book-placeholder-1.png" mode="aspectFill"></image>
				</view>
			</view>

			<view class="search-bar">
				<view class="search-icon">
					<text class="iconfont">🔍</text>
				</view>
				<input class="search-input" placeholder="搜索书名、作者、ISBN…" placeholder-class="search-placeholder" />
			</view>

			<view class="section-header">
				<text class="section-label">§ 01 · 编辑推荐</text>
				<view class="section-dots">
					<view
						class="s-dot"
						v-for="(book, index) in featuredBooks"
						:key="'feat-dot-'+index"
						:class="{ active: currentIndex === index }"
						@click="onFeaturedChange(index)"
					></view>
				</view>
			</view>

			<view class="featured-card">
				<view class="featured-glow"></view>
				<view class="featured-book-wrap">
					<image class="featured-book-cover" :src="currentBook.image" mode="aspectFill"></image>
				</view>
				<view class="featured-info">
					<view class="catalog-label">
						<text class="catalog-code">{{ currentBook.catalog }}</text>
					</view>
					<text class="featured-title">{{ currentBook.title }}</text>
					<text class="featured-author">{{ currentBook.author }}</text>
					<text class="featured-synopsis">{{ currentBook.synopsis }}</text>
					<view class="featured-meta">
						<view class="rating">
							<text class="rating-stars">{{ starRating(currentBook.rating) }}</text>
							<text class="rating-num">{{ currentBook.rating }}</text>
						</view>
						<view class="status-tag" :class="currentBook.status">
							<text class="status-text">{{ statusLabel(currentBook.status) }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="section-header compact">
				<text class="section-label">§ 02 · 热门借阅</text>
			</view>

			<scroll-view class="popular-scroll" scroll-x :show-scrollbar="false">
				<view class="popular-list">
					<view class="popular-item" v-for="(book, index) in popularBooks" :key="'pop-'+index">
						<view class="popular-cover-wrap">
							<image class="popular-cover" :src="book.image" mode="aspectFill"></image>
						</view>
						<text class="popular-title">{{ book.title }}</text>
						<text class="popular-author">{{ book.author }}</text>
					</view>
				</view>
			</scroll-view>

			<view class="section-header compact">
				<text class="section-label">§ 03 · 统计数据</text>
			</view>

			<view class="stats-card">
				<view class="stat-item">
					<text class="stat-value">3,200+</text>
					<text class="stat-label">馆藏图书</text>
				</view>
				<view class="stat-divider"></view>
				<view class="stat-item">
					<text class="stat-value">1,840</text>
					<text class="stat-label">本月借阅</text>
				</view>
				<view class="stat-divider"></view>
				<view class="stat-item">
					<text class="stat-value indigo">4.8</text>
					<text class="stat-label">用户评分</text>
				</view>
			</view>

			<view class="cta-btn" @click="getStarted">
				<text class="cta-text">进入书库</text>
				<text class="cta-arrow">→</text>
			</view>

			<view class="footer">
				<text class="footer-text">ARÔME · 图书借阅系统</text>
			</view>
		</view>
	</view>
</template>

<script>
	export default {
		data() {
			return {
				currentIndex: 0,
				currentDate: '',
				featuredBooks: [
					{ image: '/static/book-placeholder-1.png', title: '一个人的好天气', author: '青山七惠', catalog: 'I313.45', rating: 4.5, status: 'available', synopsis: '青春的迷茫与成长，一个女孩在东京的独居生活，细腻的日常与温柔的治愈。' },
					{ image: '/static/book-placeholder-2.png', title: '白夜行', author: '东野圭吾', catalog: 'I313.45', rating: 4.8, status: 'borrowed', synopsis: '一桩谋杀案，两个少年，长达十九年的纠缠与救赎，日本推理小说巅峰之作。' },
					{ image: '/static/book-placeholder-3.png', title: '百年孤独', author: '马尔克斯', catalog: 'I775.14', rating: 4.9, status: 'available', synopsis: '布恩迪亚家族百年兴衰史，魔幻现实主义文学的经典之作，马孔多小镇的孤独与轮回。' }
				],
				popularBooks: [
					{ image: '/static/book-placeholder-4.png', title: '活着', author: '余华' },
					{ image: '/static/book-placeholder-5.png', title: '小王子', author: '圣埃克苏佩里' },
					{ image: '/static/book-placeholder-6.png', title: '追风筝的人', author: '卡勒德·胡赛尼' },
					{ image: '/static/book-placeholder-1.png', title: '挪威的森林', author: '村上春树' },
					{ image: '/static/book-placeholder-2.png', title: '嫌疑人X的献身', author: '东野圭吾' }
				]
			}
		},
		computed: {
			currentBook() {
				return this.featuredBooks[this.currentIndex] || this.featuredBooks[0];
			}
		},
		created() {
			const d = new Date();
			const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
			const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
			this.currentDate = `${days[d.getDay()]} · ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
		},
		methods: {
			onFeaturedChange(index) {
				this.currentIndex = index;
			},
			starRating(rating) {
				const full = Math.floor(rating);
				const half = rating - full >= 0.5 ? 1 : 0;
				const empty = 5 - full - half;
				return '★'.repeat(full) + (half ? '★' : '') + '☆'.repeat(empty);
			},
			statusLabel(status) {
				const map = { available: '可借阅', borrowed: '借阅中', reserved: '已预约' };
				return map[status] || '未知';
			},
			getStarted() {
				uni.navigateTo({
					url: '/pages/book-menu/book-menu'
				});
			}
		}
	}
</script>

