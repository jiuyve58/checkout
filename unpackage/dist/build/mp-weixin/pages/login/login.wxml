<view class="page-container"><view class="bg-decoration"><view class="circle circle-1"></view><view class="circle circle-2"></view></view><scroll-view class="form-scroll" scroll-y><view class="form-header"><view class="logo-wrap"><image class="logo" src="{{a}}" mode="aspectFit"></image></view><text class="app-title">书香借阅</text><text class="app-subtitle">{{b}}</text></view><view class="form-tabs"><view class="{{['tab-item', c && 'active']}}" bindtap="{{d}}"><text class="tab-text">登录</text></view><view class="{{['tab-item', e && 'active']}}" bindtap="{{f}}"><text class="tab-text">注册</text></view></view><view class="form-body"><view class="input-group"><view class="input-icon"><text class="icon-text">◎</text></view><input class="form-input" type="text" placeholder="请输入用户名" placeholder-class="input-placeholder" value="{{g}}" bindinput="{{h}}"/></view><view wx:if="{{i}}" class="input-group"><view class="input-icon"><text class="icon-text">◉</text></view><input class="form-input" type="text" placeholder="请输入昵称（选填）" placeholder-class="input-placeholder" value="{{j}}" bindinput="{{k}}"/></view><view class="input-group"><view class="input-icon"><text class="icon-text">✦</text></view><input class="form-input" password="{{l}}" type="text" placeholder="请输入密码（至少6位）" placeholder-class="input-placeholder" value="{{m}}" bindinput="{{n}}"/><view class="toggle-pwd" bindtap="{{p}}"><text class="toggle-text">{{o}}</text></view></view><view wx:if="{{q}}" class="input-group"><view class="input-icon"><text class="icon-text">✦</text></view><input class="form-input" password="{{true}}" type="text" placeholder="请再次输入密码" placeholder-class="input-placeholder" value="{{r}}" bindinput="{{s}}"/></view><view wx:if="{{t}}" class="error-tip"><text class="error-text">{{v}}</text></view><view class="{{['submit-btn', x && 'loading']}}" bindtap="{{y}}"><text class="submit-text">{{w}}</text></view><view wx:if="{{z}}" class="form-footer"><text class="footer-text">还没有账号？</text><text class="footer-link" bindtap="{{A}}">立即注册</text></view><view wx:else class="form-footer"><text class="footer-text">已有账号？</text><text class="footer-link" bindtap="{{B}}">去登录</text></view></view></scroll-view><view wx:if="{{C}}" class="close-btn" bindtap="{{D}}"><text class="close-icon">×</text></view></view>