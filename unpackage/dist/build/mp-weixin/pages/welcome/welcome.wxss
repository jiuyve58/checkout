.page-container{width:100%;min-height:100vh;background:linear-gradient(180deg,#1a1a2e,#16213e,#0f3460);position:relative;overflow:hidden}.bg-decoration{position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none}.bg-gradient{position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(139,90,43,.3) 0%,transparent 70%)}.floating-shape{position:absolute;border-radius:50%;opacity:.1}.shape-1{width:200px;height:200px;background:linear-gradient(135deg,#8b5a2b,sienna);top:200px;left:-50px}.shape-2{width:150px;height:150px;background:linear-gradient(135deg,#d4c4a8,#b8a68a);bottom:200px;right:-30px}.content-wrapper{position:relative;z-index:10;padding:60px 32px 40px;display:flex;flex-direction:column;min-height:100vh}.header-section{margin-bottom:40px}.brand-text{font-size:13px;letter-spacing:3px;color:rgba(255,255,255,.6);font-weight:500}.title-section{margin-bottom:24px}.main-title{display:block;font-size:42px;font-weight:700;color:#fff;line-height:1.2;letter-spacing:1px}.main-title.highlight{background:linear-gradient(135deg,#d4c4a8,#8b7355);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.desc-section{margin-bottom:50px}.desc-text{font-size:15px;color:rgba(255,255,255,.65);line-height:1.6}.books-section{margin-bottom:50px}.books-stack{display:flex;align-items:center;justify-content:center;height:180px;position:relative}.book-item{position:absolute;width:100px;height:140px;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.3);transition:transform .3s ease}.book-cover{width:100%;height:100%;border-radius:8px;background-color:#2a2a3e}.stats-section{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.08);border-radius:20px;padding:24px 20px;margin-bottom:50px;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.1)}.stat-card{display:flex;flex-direction:column;align-items:center;flex:1}.stat-value{font-size:26px;font-weight:700;color:#fff;line-height:1}.stat-plus{font-size:18px;font-weight:600;color:#d4c4a8}.stat-label{font-size:12px;color:rgba(255,255,255,.5);margin-top:6px}.stat-divider{width:1px;height:30px;background:rgba(255,255,255,.15)}.button-section{flex:1;display:flex;align-items:flex-end}.enter-btn{width:100%;height:56px;background:linear-gradient(135deg,#8b5a2b,sienna);border-radius:28px;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 8px 32px rgba(139,90,43,.4);transition:transform .15s ease;margin-bottom:30px}.enter-btn:active{transform:scale(.98)}.btn-text{font-size:17px;font-weight:600;color:#fff;letter-spacing:2px}.btn-arrow{font-size:20px;color:#fff;font-weight:300}.footer-section{text-align:center;padding-bottom:20px}.footer-text{font-size:12px;color:rgba(255,255,255,.35);letter-spacing:2px}