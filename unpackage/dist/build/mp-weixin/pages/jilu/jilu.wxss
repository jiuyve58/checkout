.page-container{width:100%;height:100vh;background-color:#fafaf8;display:flex;flex-direction:column}.header-area{padding:50px 24px 20px;background:linear-gradient(180deg,#f2ece0,#fafaf8 85%)}.page-label{font-size:13px;color:#8b7355;letter-spacing:2px;font-weight:500}.page-title{font-size:32px;font-weight:700;color:#3d2817;display:block;margin-top:6px}.page-subtitle{font-size:14px;color:#8b7355;display:block;margin-top:4px}.tabs{display:flex;gap:8px;padding:12px 24px;background-color:#fff;border-bottom:1px solid #F0E8DC}.tab-item{flex:1;height:36px;display:flex;align-items:center;justify-content:center;background-color:#faf6f0;border-radius:18px;transition:all .2s ease}.tab-item.active{background-color:#3d2817}.tab-text{font-size:14px;font-weight:600;color:#8b7355}.active .tab-text{color:#fff}.empty-state{display:flex;flex-direction:column;align-items:center;padding:80px 0}.empty-icon{font-size:64px;margin-bottom:16px}.empty-text{font-size:16px;font-weight:600;color:#3d2817;margin-bottom:8px}.empty-hint{font-size:14px;color:#b0a89e}.login-btn{background:linear-gradient(135deg,#3d2817,#5c3a1f);border-radius:24px;padding:10px 36px;margin-top:16px}.login-btn-text{font-size:14px;font-weight:600;color:#fff}.content-area{flex:1;padding:0 24px}.month-section{margin-top:24px}.month-label{font-size:14px;font-weight:600;color:#3d2817;display:block;margin-bottom:12px}.record-list{display:flex;flex-direction:column;gap:12px}.record-card{display:flex;gap:14px;background-color:#fff;border-radius:14px;padding:14px;box-shadow:0 2px 14px rgba(60,40,20,.05)}.record-cover{width:76px;height:100px;border-radius:8px;flex-shrink:0;background-color:#e8dfd0}.record-info{flex:1;display:flex;flex-direction:column;justify-content:space-between}.record-top{display:flex;justify-content:space-between;align-items:flex-start}.record-name{font-size:16px;font-weight:700;color:#3d2817;flex:1;margin-right:8px}.record-status{font-size:11px;font-weight:600;padding:3px 10px;border-radius:5px;flex-shrink:0}.record-status.borrowed{background-color:rgba(52,152,219,.12)}.record-status.borrowed .status-text{color:#3498db}.record-status.returned{background-color:rgba(58,176,128,.12)}.record-status.returned .status-text{color:#3ab080}.record-status.overdue{background-color:rgba(231,76,60,.12)}.record-status.overdue .status-text{color:#e74c3c}.status-text{font-size:11px;font-weight:600}.record-actions{margin-top:8px;display:flex;justify-content:flex-end}.return-btn{background:linear-gradient(135deg,#8b5a2b,sienna);border-radius:16px;padding:6px 20px}.return-text{font-size:13px;font-weight:600;color:#fff}.record-author{font-size:13px;color:#8b7355;display:block}.record-dates{display:flex;align-items:center;gap:10px;margin-top:4px}.date-block{display:flex;align-items:center;gap:4px}.date-label{font-size:11px;color:#b0a89e}.date-value{font-size:12px;font-weight:600;color:#3d2817}.date-divider{width:1px;height:12px;background-color:#e8dfd0}.bottom-space{height:120px}.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:72px;background-color:#fff;display:flex;justify-content:space-around;align-items:flex-start;padding:8px 16px 16px;z-index:50;box-shadow:0 -2px 24px rgba(60,40,20,.06);border-radius:24px 24px 0 0}.nav-item{display:flex;flex-direction:column;align-items:center;gap:2px;padding-top:4px;position:relative}.nav-item.active .nav-label{color:#3d2817;font-weight:600}.nav-item.active .nav-icon{opacity:1}.nav-icon{width:24px;height:24px;margin-bottom:2px;opacity:.55;transition:opacity .15s ease}.center-icon{width:28px;height:28px}.nav-label{font-size:11px;color:#b0a89e;transition:color .15s ease}