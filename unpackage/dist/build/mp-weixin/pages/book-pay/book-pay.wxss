t:8px}.payment-radio{width:22px;height:22px;border-radius:50%;border:2px solid #D4C9BE;display:flex;align-items:center;justify-content:center;flex-shrink:0}.payment-radio.checked{background-color:#8b5a2b;border-color:#8b5a2b}.summary-card{padding:18px 20px}.summary-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.summary-label{font-size:14px;color:#6b5b4f}.summary-value{font-size:14px;font-weight:600;color:#3d2817}.summary-divider{height:1px;background-color:rgba(139,90,43,.1);margin:14px 0}.total-row{margin-bottom:0}.total-label{font-size:15px;font-weight:600;color:#3d2817}.total-value{font-size:24px;font-weight:700;color:#8b5a2b}.bottom-bar{position:fixed;left:0;right:0;bottom:0;background-color:#fff;padding:14px 20px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;box-shadow:0 -4px 20px rgba(0,0,0,.06);border-radius:28px 28px 0 0;z-index:50}.bottom-info{display:flex;align-items:baseline;gap:4px}.total-label{font-size:13px;color:#999}.total-price{font-size:26px;font-weight:700;color:#8b5a2b}.confirm-btn{height:54px;padding:0 32px;background:linear-gradient(135deg,#8b5a2b,sienna);border-radius:27px;display:flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 4px 16px rgba(139,90,43,.3)}.confirm-text{font-size:16px;font-weight:600;color:#fff}