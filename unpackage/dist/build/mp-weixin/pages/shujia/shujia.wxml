<view class="page-container"><view class="header-area"><text class="page-label">MY SHELF · 我的书架</text><text class="page-title">{{a}}的书架</text><view class="stats-row"><view class="stat-item"><text class="stat-num">{{b}}</text><text class="stat-unit">累计借阅</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-num">{{c}}</text><text class="stat-unit">借阅中</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-num">{{d}}</text><text class="stat-unit">已归还</text></view></view></view><scroll-view class="content-area" scroll-y><view wx:if="{{e}}" class="empty-state"><view class="empty-icon">🔐</view><text class="empty-text">请先登录</text><text class="empty-hint">登录后查看你的书架</text><view class="login-btn" bindtap="{{f}}"><text class="login-btn-text">立即登录</text></view></view><view wx:if="{{g}}" class="section"><view class="section-header"><text class="section-symbol">§</text><text class="section-text">借阅中</text></view><view wx:for="{{h}}" wx:for-item="item" wx:key="i" class="borrow-card"><image class="borrow-cover" src="{{item.a}}" mode="aspectFill" binderror="{{item.b}}"></image><view class="borrow-info"><text class="borrow-title">{{item.c}}</text><text class="borrow-author">{{item.d}}</text><text class="borrow-date">借出日期 {{item.e}}</text><view class="borrow-tags"><view class="tag-expire"><text class="tag-expire-text">{{item.f}}</text></view><view class="tag-date"><text class="tag-date-text">到期日 {{item.g}}</text></view></view></view><view class="return-btn" bindtap="{{item.h}}"><text class="return-btn-text">归还</text></view></view></view><view wx:if="{{i}}" class="section"><view class="section-header"><text class="section-symbol">§</text><text class="section-text">已预约</text></view><view wx:for="{{j}}" wx:for-item="item" wx:key="e" class="borrow-card"><image class="borrow-cover" src="{{item.a}}" mode="aspectFill" binderror="{{item.b}}"></image><view class="borrow-info"><text class="borrow-title">{{item.c}}</text><text class="borrow-author">{{item.d}}</text><view class="tag-reserved"><text class="tag-reserved-text">归还后通知取书</text></view></view></view></view><view class="section"><view class="section-header"><text class="section-symbol">§</text><text class="section-text">心愿书单</text></view><scroll-view class="wish-scroll" scroll-x><view class="wish-list"><view wx:for="{{k}}" wx:for-item="book" wx:key="d" class="wish-item"><view class="wish-cover-wrap"><image class="wish-cover" src="{{book.a}}" mode="aspectFill" binderror="{{book.b}}"></image></view><text class="wish-name">{{book.c}}</text></view></view></scroll-view></view><view class="bottom-space"></view></scroll-view><view class="bottom-nav"><view class="nav-item" bindtap="{{m}}"><image class="nav-icon" src="{{l}}" mode="aspectFit"></image><text class="nav-label">首页</text></view><view class="nav-item" bindtap="{{o}}"><image class="nav-icon" src="{{n}}" mode="aspectFit"></image><text class="nav-label">书库</text></view><view class="nav-item active"><image class="nav-icon" src="{{p}}" mode="aspectFit"></image><text class="nav-label">书架</text></view><view class="nav-item" bindtap="{{r}}"><image class="nav-icon" src="{{q}}" mode="aspectFit"></image><text class="nav-label">记录</text></view><view class="nav-item" bindtap="{{t}}"><image class="nav-icon" src="{{s}}" mode="aspectFit"></image><text class="nav-label">我的</text></view></view></view>