<view class="page-container"><view class="header-area"><text class="page-label">HISTORY · 借阅记录</text><text class="page-title">借阅历史</text><text class="page-subtitle">累计借阅 {{a}} 册</text></view><view class="tabs"><view class="{{['tab-item', b && 'active']}}" bindtap="{{c}}"><text class="tab-text">全部</text></view><view class="{{['tab-item', d && 'active']}}" bindtap="{{e}}"><text class="tab-text">借阅中</text></view><view class="{{['tab-item', f && 'active']}}" bindtap="{{g}}"><text class="tab-text">已归还</text></view></view><scroll-view class="content-area" scroll-y bindscrolltolower="{{l}}"><view wx:if="{{h}}" class="empty-state"><view class="empty-icon">🔐</view><text class="empty-text">请先登录</text><text class="empty-hint">登录后查看借阅记录</text><view class="login-btn" bindtap="{{i}}"><text class="login-btn-text">立即登录</text></view></view><view wx:elif="{{j}}" class="empty-state"><view class="empty-icon">📚</view><text class="empty-text">暂无借阅记录</text><text class="empty-hint">去书库借一本好书吧</text></view><view wx:for="{{k}}" wx:for-item="group" wx:key="c" class="month-section"><text class="month-label">{{group.a}}</text><view class="record-list"><view wx:for="{{group.b}}" wx:for-item="item" wx:key="m" class="record-card"><image class="record-cover" src="{{item.a}}" mode="aspectFill" binderror="{{item.b}}"></image><view class="record-info"><view class="record-top"><text class="record-name">{{item.c}}</text><view class="{{['record-status', item.e]}}"><text class="status-text">{{item.d}}</text></view></view><text class="record-author">编号: {{item.f}}</text><view class="record-dates"><view class="date-block"><text class="date-label">借出</text><text class="date-value">{{item.g}}</text></view><view class="date-divider"></view><view class="date-block"><text class="date-label">到期</text><text class="date-value">{{item.h}}</text></view></view><view wx:if="{{item.i}}" class="record-actions"><view class="return-btn" bindtap="{{item.j}}"><text class="return-text">归还</text></view></view><view wx:elif="{{item.k}}" class="record-dates"><view class="date-block"><text class="date-label">归还</text><text class="date-value">{{item.l}}</text></view></view></view></view></view></view><view class="bottom-space"></view></scroll-view><view class="bottom-nav"><view class="nav-item" bindtap="{{n}}"><image class="nav-icon" src="{{m}}" mode="aspectFit"></image><text class="nav-label">首页</text></view><view class="nav-item" bindtap="{{p}}"><image class="nav-icon" src="{{o}}" mode="aspectFit"></image><text class="nav-label">书库</text></view><view class="nav-item" bindtap="{{r}}"><image class="nav-icon" src="{{q}}" mode="aspectFit"></image><text class="nav-label">书架</text></view><view class="nav-item active"><image class="nav-icon" src="{{s}}" mode="aspectFit"></image><text class="nav-label">记录</text></view><view class="nav-item" bindtap="{{v}}"><image class="nav-icon" src="{{t}}" mode="aspectFit"></image><text class="nav-label">我的</text></view></view></view>