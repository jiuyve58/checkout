<view class="page-container"><view wx:if="{{a}}" class="header-area"><view class="profile-top logged-out" bindtap="{{c}}"><view class="avatar-wrap"><image class="avatar" src="{{b}}" mode="aspectFill"></image></view><view class="user-info"><text class="user-name">未登录</text><text class="user-id">点击登录 / 注册账号</text></view><view class="login-arrow"><text class="arrow-icon">›</text></view></view></view><view wx:else class="header-area"><view class="profile-top"><view class="avatar-wrap"><image class="avatar" src="{{d}}" mode="aspectFill" binderror="{{e}}"></image><view class="online-dot"></view></view><view class="user-info"><text class="user-name">{{f}}</text><text class="user-id">会员 No. {{g}}</text><view class="member-badge"><text class="member-icon">★</text><text class="member-text">{{h}}</text></view></view></view></view><scroll-view class="content-area" scroll-y><block wx:if="{{i}}"><view class="login-prompt-card"><view class="prompt-icon">📖</view><text class="prompt-title">登录后享受更多服务</text><text class="prompt-desc">登录后可借阅图书、查看借阅记录、管理书架</text><view class="prompt-btn" bindtap="{{j}}"><text class="prompt-btn-text">立即登录</text></view></view></block><block wx:else><view class="stats-bar"><view class="stat-item"><text class="stat-value">{{k}}</text><text class="stat-label">累计借阅</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{l}}</text><text class="stat-label">借阅中</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{m}}</text><text class="stat-label">已归还</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{n}}</text><text class="stat-label">已逾期</text></view></view><view wx:if="{{o}}" class="section-card"><view class="card-header"><text class="card-title">当前借阅</text><text class="card-hint">{{p}}本借阅中</text></view><view wx:for="{{q}}" wx:for-item="item" wx:key="f" class="current-borrow"><image class="borrow-cover" src="{{item.a}}" mode="aspectFill" binderror="{{item.b}}"></image><view class="borrow-detail"><text class="borrow-title">{{item.c}}</text><text class="borrow-author">到期: {{item.d}}</text><view class="borrow-actions"><view class="return-btn" bindtap="{{item.e}}"><text class="return-text">归还</text></view></view></view></view></view><view wx:else class="section-card empty-borrows"><text class="empty-text">暂无借阅中的图书</text><view class="browse-btn" bindtap="{{r}}"><text class="browse-text">去书库选书</text></view></view><view class="menu-section"><text class="menu-title">借阅服务</text><view class="menu-list"><view wx:for="{{s}}" wx:for-item="item" wx:key="e" class="menu-item" bindtap="{{item.f}}"><view class="menu-left"><view class="menu-icon-wrap"><text class="menu-icon">{{item.a}}</text></view><text class="menu-text">{{item.b}}</text></view><view class="menu-right"><view wx:if="{{item.c}}" class="menu-badge">{{item.d}}</view><text class="menu-arrow">›</text></view></view></view></view><view class="menu-section"><text class="menu-title">账户设置</text><view class="menu-list"><view class="menu-item" bindtap="{{t}}"><view class="menu-left"><view class="menu-icon-wrap"><text class="menu-icon">◉</text></view><text class="menu-text">修改昵称</text></view><view class="menu-right"><text class="menu-arrow">›</text></view></view><view class="menu-item" bindtap="{{v}}"><view class="menu-left"><view class="menu-icon-wrap logout-icon"><text class="menu-icon">↻</text></view><text class="menu-text logout-text">退出登录</text></view><view class="menu-right"><text class="menu-arrow">›</text></view></view></view></view></block><view class="bottom-space"></view></scroll-view><view class="bottom-nav"><view class="nav-item" bindtap="{{x}}"><image class="nav-icon" src="{{w}}" mode="aspectFit"></image><text class="nav-label">首页</text></view><view class="nav-item" bindtap="{{z}}"><image class="nav-icon" src="{{y}}" mode="aspectFit"></image><text class="nav-label">书库</text></view><view class="nav-item" bindtap="{{B}}"><image class="nav-icon" src="{{A}}" mode="aspectFit"></image><text class="nav-label">书架</text></view><view class="nav-item" bindtap="{{D}}"><image class="nav-icon" src="{{C}}" mode="aspectFit"></image><text class="nav-label">记录</text></view><view class="nav-item active"><image class="nav-icon" src="{{E}}" mode="aspectFit"></image><text class="nav-label">我的</text></view></view></view>