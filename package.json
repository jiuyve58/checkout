{
  "name": "library-api-server",
  "version": "1.0.0",
  "description": "图书借阅系统后端API服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prod": "NODE_ENV=production node server.js",
