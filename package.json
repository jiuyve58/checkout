    "pm2-stop": "pm2 stop library-api",
    "pm2-delete": "pm2 delete library-api"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz"
  }
}